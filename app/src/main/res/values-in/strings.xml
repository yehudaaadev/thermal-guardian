    <string name="settings_category_about">Tentang Aplikasi</string>
    <string name="settings_about_desc">Aplikasi pemantau termal native Android (Kotlin + Jetpack Compose) tanpa ketergantungan Google Play Services. Dioptimalkan untuk Huawei HarmonyOS/EMUI dan Android pada umumnya.</string>
