    <!-- Onboarding & Huawei Guide -->
    <string name="onboarding_title">Selamat Datang di ThermalGuard</string>
    <string name="onboarding_subtitle">Jaga suhu HP tetap dingin, cegah pelambatan sistem, dan lindungi kesehatan baterai Anda.</string>
    <string name="onboarding_permission_notification_title">1. Aktifkan Izin Notifikasi</string>
    <string name="onboarding_permission_notification_desc">Dibutuhkan untuk menampilkan suhu di status bar dan mengirim peringatan dini saat HP mulai panas.</string>
    <string name="onboarding_permission_usage_title">2. Izin Akses Penggunaan (Opsional)</string>
    <string name="onboarding_permission_usage_desc">Memungkinkan aplikasi mendeteksi aplikasi apa yang membebani prosesor dan menghasilkan panas.</string>
    <string name="onboarding_huawei_title">3. Panduan Khusus Huawei / EMUI / HarmonyOS</string>
    <string name="onboarding_huawei_desc">Sistem EMUI/HarmonyOS sangat agresif mematikan service di latar belakang. Atur peluncuran manual agar pemantauan tidak terputus:</string>
    <string name="huawei_step_1">1. Buka Pengaturan &gt; Baterai &gt; Peluncuran Aplikasi (App Launch).</string>
    <string name="huawei_step_2">2. Cari "ThermalGuard" dan matikan "Kelola otomatis".</string>
    <string name="huawei_step_3">3. Aktifkan "Peluncuran otomatis", "Peluncuran sekunder", dan "Jalankan di latar belakang".</string>
    <string name="btn_open_app_launch">Buka Pengaturan Peluncuran Aplikasi</string>
    <string name="btn_open_battery_opt">Buka Pengaturan Optimasi Baterai</string>
    <string name="btn_get_started">Mulai Sekarang</string>
    <string name="btn_skip">Lewati</string>
    <string name="btn_continue">Lanjutkan</string>

