    <!-- Onboarding & Huawei Guide -->
    <string name="onboarding_title">Welcome to ThermalGuard</string>
    <string name="onboarding_subtitle">Keep your phone cool, prevent throttling, and protect battery lifespan.</string>
    <string name="onboarding_permission_notification_title">1. Enable Notifications</string>
    <string name="onboarding_permission_notification_desc">Required to show ongoing temperature status in status bar and prompt overheat warnings.</string>
    <string name="onboarding_permission_usage_title">2. Usage Access (Optional)</string>
    <string name="onboarding_permission_usage_desc">Allows identifying apps that consume excessive CPU and produce heat when device warms up.</string>
    <string name="onboarding_huawei_title">3. Huawei / OEM Background Guide</string>
    <string name="onboarding_huawei_desc">EMUI and HarmonyOS aggressively kill background monitoring. Configure manual launch settings to keep ThermalGuard running reliably:</string>
    <string name="huawei_step_1">1. Open Settings &gt; Battery &gt; App Launch.</string>
    <string name="huawei_step_2">2. Find "ThermalGuard" and turn OFF "Manage automatically".</string>
    <string name="huawei_step_3">3. Enable "Auto-launch", "Secondary launch", and "Run in background".</string>
    <string name="btn_open_app_launch">Open App Launch Settings</string>
    <string name="btn_open_battery_opt">Open Battery Optimization</string>
